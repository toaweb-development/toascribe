{
  // Production build: src -> dist, run with `node dist/index.js` (typescript §13).
  // Imports the other workspace packages through their dist/, so they are built first (pnpm -r build order).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // dist/cli.d.ts: the cli imports `@toascribe/api/cli`.
    "declaration": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
