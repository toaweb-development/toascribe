{
  "name": "@toascribe/api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "The toascribe API: Hono on Node. Owns all data and business logic.",
  "exports": {
    "./cli": {
      "source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:deps": "pnpm --filter \"@toascribe/api^...\" run build",
    "dev": "pnpm run build:deps && NODE_ENV=development node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@toascribe/auth": "workspace:*",
    "@toascribe/backup": "workspace:*",
    "@toascribe/blocks": "workspace:*",
    "@toascribe/db": "workspace:*",
    "@toascribe/http": "workspace:*",
    "@toascribe/install": "workspace:*",
    "@toascribe/media": "workspace:*",
    "@toascribe/shared": "workspace:*",
    "@toascribe/telemetry": "workspace:*",
    "@toascribe/updates": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "otpauth": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "uqr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@node-rs/argon2": "catalog:",
    "@toascribe/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
