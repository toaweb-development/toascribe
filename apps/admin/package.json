{
  "name": "@toascribe/admin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "The admin app and the setup wizard: a Nuxt 4 app served under /admin.",
  "scripts": {
    "dev": "nuxt dev --port 3002",
    "start": "node .output/server/index.mjs",
    "lint": "nuxt prepare && eslint .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "build": "nuxi build",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-bold": "catalog:",
    "@tiptap/extension-code": "catalog:",
    "@tiptap/extension-document": "catalog:",
    "@tiptap/extension-hard-break": "catalog:",
    "@tiptap/extension-italic": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-text": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@toascribe/blocks": "workspace:*",
    "@toascribe/nuxt-base": "workspace:*",
    "@toascribe/shared": "workspace:*",
    "nuxt": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@nuxt/eslint": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "otpauth": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
