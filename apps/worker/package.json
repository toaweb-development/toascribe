{
  "name": "@toascribe/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The toascribe background worker: pg-boss jobs and schedules. Same image as the API.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:deps": "pnpm --filter \"@toascribe/worker^...\" run build",
    "dev": "pnpm run build:deps && NODE_ENV=development node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "pnpm run build:deps && eslint .",
    "typecheck": "pnpm run build:deps && tsc --noEmit",
    "test": "pnpm run build:deps && vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@toascribe/db": "workspace:*",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@toascribe/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
