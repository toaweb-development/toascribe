{
  "name": "@toascribe/site",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "The public site: a Nuxt 4 app that renders content through the active theme layer.",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "start": "node .output/server/index.mjs",
    "lint": "nuxt prepare && eslint .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "nuxi build",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@toascribe/theme-default": "workspace:*",
    "nuxt": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
