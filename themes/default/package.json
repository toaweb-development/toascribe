{
  "name": "@toascribe/theme-default",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "The default theme, a Nuxt layer on @toascribe/site-core that apps/site extends when toascribe.toml names it: the templates of WordPress' hierarchy, a layout and the look of every core block (WCAG 2.2 AA).",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "i18n",
    "nuxt.config.ts",
    "theme.json"
  ],
  "scripts": {
    "lint": "nuxt prepare && eslint .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "nuxt prepare",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "catalog:",
    "@toascribe/block-views": "workspace:*",
    "@toascribe/site-core": "workspace:*",
    "tailwindcss": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
