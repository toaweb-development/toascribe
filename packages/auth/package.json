{
  "name": "@toascribe/auth",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Password hashing and checking (argon2id, imported WordPress formats) and token helpers, shared by the api and the cli. Node only; no HTTP framework, no database.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@toascribe/shared": "workspace:*",
    "bcryptjs": "catalog:"
  },
  "devDependencies": {
    "@toascribe/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
