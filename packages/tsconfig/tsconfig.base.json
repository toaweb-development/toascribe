{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext", // gives moduleResolution nodenext
    "rewriteRelativeImportExtensions": true, // imports are written ./x.ts; tsc turns them into ./x.js in dist/
    "strict": true,
    "noUncheckedIndexedAccess": true, // arr[i] and record[key] may be undefined
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true, // import type is written explicitly
    "isolatedModules": true,
    "erasableSyntaxOnly": true, // no enum, namespace or parameter properties (typescript §4)
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"], // TypeScript 7 defaults to [] - list what you need
    // A workspace library lists "source": "./src/index.ts" first in its exports. Typecheck, typed lint and Vitest read
    // the library's src/ with this condition, so none of them needs dist/. Node ignores the condition at run time and
    // loads dist/, as do the Nuxt builds until they set it too.
    "customConditions": ["source"],
    "sourceMap": true
  }
}
