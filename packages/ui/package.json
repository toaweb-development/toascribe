{
  "name": "@toascribe/ui",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "The admin's design system «Blekk» (M2.1) as a Nuxt layer: the tokens (light and dark), the Geist fonts, Nuxt UI's theme for the shared components, and the contrast check of every colour pair.",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./blekk.css": "./app/assets/theme/blekk.css"
  },
  "files": [
    "app",
    "nuxt.config.ts",
    "src"
  ],
  "scripts": {
    "lint": "nuxt prepare && eslint .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "build": "echo \"ui is a Nuxt layer: the admin, which extends it, builds it, so it has no build of its own\"",
    "contrast": "node --experimental-strip-types src/contrast-report.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@nuxt/ui": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
