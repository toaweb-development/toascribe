  },
  "dependencies": {
    "@toascribe/db": "workspace:*",
    "@toascribe/http": "workspace:*",
    "@toascribe/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@toascribe/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
