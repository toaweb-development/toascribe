  "description": "The update check (M1.7, K-290): the newest release from the public image tags (ghcr.io), behind a small source interface. Node only; the worker and the CLI use it.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
