{
  "name": "@toascribe/backup",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Backups (M1.7, K-292, K-293): one file with the database dump, the uploads and a manifest; verify, list, prune and restore. Node only; the CLI and the worker use it, in the api image (pg_dump, psql, zstd, age).",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@toascribe/db": "workspace:*",
    "@toascribe/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "pino": "catalog:",
    "smol-toml": "catalog:",
    "tar": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@toascribe/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
