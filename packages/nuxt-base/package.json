{
  "name": "@toascribe/nuxt-base",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "The Nuxt layer that apps/site and apps/admin share: API layer, API plugin, status component, Nuxt UI and i18n setup, security headers and CSP, runtime config, head basics.",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "i18n",
    "nuxt.config.ts",
    "server"
  ],
  "scripts": {
    "lint": "nuxt prepare && eslint .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "build": "echo \"nuxt-base is a Nuxt layer: the apps that extend it build it, so it has no build of its own\"",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "@toascribe/shared": "workspace:*",
    "nuxt-security": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:",
    "eslint": "catalog:",
    "nuxt": "catalog:",
    "ofetch": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
