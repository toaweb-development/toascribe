{
  // Typecheck and typed lint for everything in the package, including tests and tool configs.
  "extends": "@toascribe/tsconfig/tsconfig.base.json",
  // Each block's block.json is imported as a module (`with { type: 'json' }`); tsc copies it into dist/ with the build.
  "compilerOptions": { "resolveJsonModule": true },
  "include": ["src", "test", "vitest.config.ts"]
}
