{
  "name": "toascribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted publishing system in TypeScript: Nuxt 4, Hono on Node, PostgreSQL.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "lint": "eslint . && pnpm --filter @toascribe/site --filter @toascribe/admin --if-present lint",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@toascribe/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
