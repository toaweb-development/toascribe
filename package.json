{
  "name": "toascribe",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted publishing system in TypeScript: Nuxt 4, Hono on Node, PostgreSQL.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "pnpm -r lint && eslint eslint.config.ts vitest.config.ts test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm -r --workspace-concurrency=1 test && vitest run --project root",
    "build": "pnpm -r build",
    "test:e2e": "pnpm --filter @toascribe/admin test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@toascribe/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
