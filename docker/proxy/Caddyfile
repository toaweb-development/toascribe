# toascribe proxy (PLAN.md «Arkitektur»). An external Traefik or nginx sends all traffic here; Caddy routes by path.
# HTTP only inside the stack: TLS belongs to the external proxy, so there is no certificate handling here.
{
	admin off
	auto_https off

	servers {
		# Believe X-Forwarded-For/-Proto/-Host from exactly one address or network: TOASCRIBE_TRUSTED_PROXY, a single IP
		# or CIDR, set in .env (README, «Behind a reverse proxy»). Never private_ranges: that would trust every
		# container and LAN host that can reach this port, and any of them could then forge a client IP.
		# Empty (the default) leaves `static` without ranges, which trusts nobody: Caddy then replaces X-Forwarded-*
		# with what it sees itself (checked with caddy 2.11.7: `caddy adapt` gives {"source":"static"}, no ranges).
		trusted_proxies static {$TOASCRIBE_TRUSTED_PROXY}
		client_ip_headers X-Forwarded-For
	}
}

# The container healthcheck. Listens on loopback only and is not published.
:8081 {
	bind 127.0.0.1
	respond /healthz 200
}

:8080 {
	# `reverse_proxy` keeps the Host header. Behind a trusted proxy it also passes X-Forwarded-Proto and -Host on,
	# so the apps see https and the public host name.
	log

	# The external proxy sets the security headers (SECURITY §7); do not advertise what runs here.
	header {
		-Server
		-X-Powered-By
	}

	# Caddy picks the route from the cleaned path but forwards the raw one, so `/api/../admin/x` or `/api%2fx` is routed
	# by one reading of the path and answered by another. Refuse a path with a dot segment, an encoded dot, slash or
	# backslash, a backslash, or an empty segment (//) before anything else looks at it (SECURITY §11 D). The query
	# string is not checked. It is a `handle`: a bare `respond` loses to the other `handle` blocks.
	@unnormalized expression `{http.request.uri}.matches("^[^?]*(?i:%2e|%2f|%5c|\\\\|/\\.\\.?(?:/|\\?|$)|//)")`
	handle @unnormalized {
		respond 400
	}

	# /setup is the first-run wizard and lives in the admin app, which is built with baseURL /admin.
	# Send the browser to the real address; a proxy rewrite would only be undone by the client router.
	@setup path /setup /setup/*
	redir @setup /admin{uri} 308

	handle /api/* {
		reverse_proxy api:3001
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy admin:3000
	}

	# Everything else is the site (also /_nuxt/* and /_nuxt_icon/*).
	handle {
		reverse_proxy site:3000
	}
}
