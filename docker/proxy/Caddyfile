# toascribe proxy (PLAN.md «Arkitektur»). An external Traefik or nginx sends all traffic here; Caddy routes by path.
# HTTP only inside the stack: TLS belongs to the external proxy, so there is no certificate handling here.

# Redacts the value of every query parameter except the ones listed below, in the field it is imported for. Caddy's
# `query` filter can only name parameters it already knows (a wildcard is read as the literal name "*"), so this is an
# allow-list written as three `regexp` filters, which Caddy applies in this order:
#   1. a listed name is marked (`action=` becomes `action~`), so that the next step skips it;
#   2. every `name=value` that is left becomes `name=REDACTED` (`;`, `%xx` and odd names are covered too, because the
#      value is everything up to the next `&` or `#`, and a name is never decoded);
#   3. the mark is turned back into `=`.
# A hostile `?action~x=secret` is redacted in step 2 and comes out as `action=x=REDACTED`. A parameter without `=` has no
# value to hide and is kept as it is. A new parameter that is safe to log (it never carries a secret, a name or an
# address) is added to the two lists below, in the same order; until then it is logged as `name=REDACTED`.
# The safe ones today are the notices of the login screen (`action`, `loggedout`, `checkemail`). Not `password`
# (`?password=changed` is a notice, but Tor wants the name hidden), `token`, `key`, `code`, `secret`, `signature`,
# `state`, `access_token` or anything else.
(redact_query) {
	{args[0]} regexp "([?&])(action|loggedout|checkemail)=" "$1$2~"
	{args[0]} regexp "([?&][^=&#]*)=[^&#]*" "$1=REDACTED"
	{args[0]} regexp "([?&])(action|loggedout|checkemail)~" "$1$2="
}

# The format of both logs: the access log (the `log` directive in :8080) and the error log (the global `log` above), which
# Caddy writes when an upstream does not answer and which carries the same request, X-Setup-Token header included.
(log_format) {
	format filter {
		wrap json
		request>headers>X-Setup-Token delete
		request>headers>X-Csrf-Token delete
		request>headers>Cookie delete
		request>headers>Authorization delete
		request>headers>Proxy-Authorization delete
		resp_headers>Set-Cookie delete
		resp_headers>X-Csrf-Token delete
		# The query of every address that is logged: the request, the Referer a page sends with its assets, and the
		# Location of a redirect (/setup?... is sent on to /admin/setup with the same query).
		import redact_query request>uri
		import redact_query request>headers>Referer
		import redact_query resp_headers>Location
	}
}

{
	admin off
	auto_https off

	# Errors (an upstream that does not answer) are logged with the whole request, so they get the same filter as the access log.
	log error_log {
		include http.log.error
		import log_format
	}

	servers {
		# Believe X-Forwarded-For/-Proto/-Host from exactly one address or network: TOASCRIBE_TRUSTED_PROXY, a single IP
		# or CIDR, set in .env (README, «Behind a reverse proxy»). Never private_ranges: that would trust every
		# container and LAN host that can reach this port, and any of them could then forge a client IP.
		# Empty (the default) leaves `static` without ranges, which trusts nobody: Caddy then replaces X-Forwarded-*
		# with what it sees itself (checked with caddy 2.11.7: `caddy adapt` gives {"source":"static"}, no ranges).
		trusted_proxies static {$TOASCRIBE_TRUSTED_PROXY}
		# Read X-Forwarded-For from the right and stop at the first address that is not trusted, so the client IP is the
		# address the trusted proxy actually saw. Without this Caddy takes the leftmost entry, which the visitor writes
		# when the proxy appends to the header instead of replacing it (README shows an nginx that replaces it).
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# The container healthcheck. Listens on loopback only and is not published.
:8081 {
	bind 127.0.0.1
	respond /healthz 200
}

:8080 {
	# `reverse_proxy` keeps the Host header. Behind a trusted proxy it also passes X-Forwarded-Proto and -Host on,
	# so the apps see https and the public host name.
	#
	# THE CLIENT IP. Every `reverse_proxy` below sets `X-Real-IP {client_ip}`, and `header_up` replaces whatever the
	# visitor sent under that name. The apps read the client IP from X-Real-IP only and never parse X-Forwarded-For
	# (the audit log and the login rate limits depend on it: M0.3). Keep that header in every new `reverse_proxy`.

	# THE ACCESS LOG keeps no secret. Caddy's own default already replaces Cookie, Authorization, Proxy-Authorization and
	# Set-Cookie with REDACTED; the filter below also deletes them, so this file does not depend on that default, and adds
	# what the default does not know: the setup token (X-Setup-Token) and the CSRF token (X-Csrf-Token, the spelling Go
	# gives X-CSRF-Token) are headers of the api. The setup address carries its token in the URL fragment
	# (/admin/setup#token=...), which a browser never sends to a server, so it never reaches this log; the old query form
	# (?token=...) and the query of an old WordPress /wp-login.php?action=rp&key=... are covered by the allow-list below.
	# The names must be written the way Go spells them (X-Csrf-Token); an unknown name is ignored without an error.
	log {
		import log_format
	}

	# The external proxy sets the security headers (SECURITY §7); do not advertise what runs here.
	header {
		-Server
		-X-Powered-By
	}

	# Caddy picks the route from the cleaned path but forwards the raw one, so `/api/../admin/x` or `/api%2fx` is routed
	# by one reading of the path and answered by another. Refuse a path with a dot segment, an encoded dot, slash or
	# backslash, a backslash, or an empty segment (//) before anything else looks at it (SECURITY §11 D). The query
	# string is not checked. It is a `handle`: a bare `respond` loses to the other `handle` blocks.
	@unnormalized expression `{http.request.uri}.matches("^[^?]*(?i:%2e|%2f|%5c|\\\\|/\\.\\.?(?:/|\\?|$)|//)")`
	handle @unnormalized {
		respond 400
	}

	# /setup is the first-run wizard and lives in the admin app, which is built with baseURL /admin.
	# Send the browser to the real address; a proxy rewrite would only be undone by the client router.
	# A `handle`, after the path check above: a bare `redir` is ordered before every `handle`.
	@setup path /setup /setup/*
	handle @setup {
		# `*` is the matcher: a first argument that starts with "/" would be read as a path matcher.
		redir * /admin{uri} 308
	}

	# The sign-in screens are in the admin app too. /login, /register and /logout (and a trailing slash) go to the same
	# page under /admin with the query string kept (`{uri}` is the whole request URI).
	@auth path /login /login/ /register /register/ /logout /logout/
	handle @auth {
		redir * /admin{uri} 308
	}

	# WordPress addresses (K-009): people's bookmarks and the links of old mails. /wp-login.php?action=lostpassword (or
	# register, logout, rp, ...) goes to /admin/login with the same query: the screens there read `action`. `route` keeps
	# the order of the two lines (a bare `redir` would run before `rewrite`); `rewrite` to a path alone replaces the path and
	# keeps the query, which `redir * /admin/login?{query}` would not do cleanly (it leaves a "?" behind with no query).
	@wplogin path /wp-login.php
	handle @wplogin {
		route {
			rewrite * /admin/login
			redir * {uri} 308
		}
	}

	# /wp-admin and everything under it (edit.php, post.php?post=1, ...) go to /admin. The rest of the path and the query
	# are dropped: those WordPress screens do not exist here, so there is nothing to map them to.
	@wpadmin path /wp-admin /wp-admin/*
	handle @wpadmin {
		redir * /admin 308
	}

	# The two routes that take a file (an upload and a replacement, M1.2) may send up to TOASCRIBE_UPLOAD_MAX_SIZE_MB MiB, the
	# whole form. MiB, not MB: Caddy reads MB as 1000 × 1000 bytes, and the api counts 1024 × 1024 (UPLOAD_MAX_SIZE_MB, the same
	# value; apps/api/src/lib/upload-limit.ts). The api has its own 1 MiB for every other body. Settings → Media can lower the
	# limit in the api, not raise it.
	@upload {
		method POST
		path_regexp ^/api/v1/media(/[0-9a-fA-F-]{36}/replace)?$
	}
	# The site's one form (the password of a protected post, M1.5) sends a few hundred bytes: nothing more is let through.
	handle /_toascribe/unlock {
		request_body {
			max_size 8KiB
		}
		reverse_proxy site:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle @upload {
		request_body {
			max_size {$TOASCRIBE_UPLOAD_MAX_SIZE_MB:64}MiB
		}
		reverse_proxy api:3001 {
			header_up X-Real-IP {client_ip}
		}
	}

	# The log of cache changes (M1.4) is for the site, which reads it on the internal network: it names the ids of drafts and
	# private files as they change, so it is not served to the world.
	handle /api/v1/public/cache/* {
		respond 404
	}

	# «Tilpass» per theme (M1.5) is for the site, which asks for its active theme only: the stored choices and «Ekstra CSS» of a
	# theme that is not active are not served to the world.
	handle /api/v1/public/customize {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:3001 {
			header_up X-Real-IP {client_ip}
		}
	}

	# The public files of the media library (M1.2): served by the api, which checks the key and the visibility (a private file is
	# never served here) and sets the type, nosniff and the download header.
	handle /uploads/* {
		reverse_proxy api:3001 {
			header_up X-Real-IP {client_ip}
		}
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy admin:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Everything else is the site (also /_nuxt/* and /_nuxt_icon/*).
	handle {
		reverse_proxy site:3000 {
			header_up X-Real-IP {client_ip}
		}
	}
}
