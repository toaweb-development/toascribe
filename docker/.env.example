# toascribe: settings for docker/compose.yaml.
#
# The three passwords and the two keys are made for you, once, and appended to docker/.env:
#
#   docker compose -f docker/compose.yaml run --rm --no-deps -T --quiet-build api toa core gen-env >> docker/.env
#
# This file lists every setting. Copy the lines you want to change into docker/.env (do not copy the whole file over
# it: the five names below would then be there twice, and the empty ones could win). Never commit docker/.env (it is in
# .gitignore). There are no defaults for the passwords and keys: a start with one empty stops with its name (postgres
# for the passwords, the api and the worker for the keys).

# ── Passwords (required) ─────────────────────────────────
# `toa core gen-env` makes them. By hand, one each:   openssl rand -hex 32
# Use hex, not base64: the app and owner passwords are put into database URLs, and the characters + / = of base64
# would have to be percent-encoded there. Use a different value for each, and for each installation.

# Superuser of the postgres container. Only used to set up the two roles below; the apps never connect as it.
POSTGRES_PASSWORD=
# Role toascribe_owner: owns the schema and runs the migrations (DDL). Only the one-shot migrate service gets it.
POSTGRES_OWNER_PASSWORD=
# Role toascribe_app: what the api and worker connect as (DML only, no DDL).
POSTGRES_APP_PASSWORD=
# Both role passwords are read once, on the first start of an empty database volume. Changing them in .env
# later does not change them in the database: use ALTER ROLE for that, then update .env to match.

# ── Keys (required) ──────────────────────────────────────
# Each is 32 random bytes, 64 hex characters:   openssl rand -hex 32
# Make two different values, and new ones for each installation.

# Encrypts what the database stores secret: the TOTP secrets and the SMTP password (AES-256-GCM). BACK IT UP, outside
# the server: if it is lost, those values cannot be read again. Rotation without data loss, in two lines: put the new key
# here and raise TOASCRIBE_ENCRYPTION_KEY_VERSION by one; put the old key in TOASCRIBE_ENCRYPTION_OLD_KEYS as v<its version>:<key>.
TOASCRIBE_ENCRYPTION_KEY=
# The number the current key goes by in what it encrypts (v1:...). Empty means 1; raise it when you replace the key.
TOASCRIBE_ENCRYPTION_KEY_VERSION=
# Earlier encryption keys, read-only: v1:<key>,v2:<key>. Empty means none. Remove one when nothing uses it any more.
TOASCRIBE_ENCRYPTION_OLD_KEYS=
# Signs the CSRF tokens. Must be different from the encryption key (the api refuses to start otherwise). Changing it
# only ends the open pages' tokens, not the sessions.
TOASCRIBE_SIGNING_KEY=

# ── E-mail (optional) ────────────────────────────────────
# Defaults for the e-mail settings; a setting saved in the admin wins over these. Mail is sent by the worker through
# an SMTP server of yours. Until a host and a sender address are set, queued mails wait and are retried.
SMTP_HOST=
# Empty: 587 for starttls, 465 for tls, 25 for none.
SMTP_PORT=
# none | starttls | tls. Empty means starttls.
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender of every mail, and the name shown with it.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ── Database ─────────────────────────────────────────────
# Compose builds DATABASE_URL (api, worker) and MIGRATION_DATABASE_URL (migrate only) from these and the passwords.
POSTGRES_DB=toascribe
POSTGRES_USER=postgres

# ── Address ──────────────────────────────────────────────
# Host port the proxy listens on. It is the only published port.
TOASCRIBE_HTTP_PORT=8080
# Host address that port is bound to. 127.0.0.1 (the default) is reachable from this machine only, which is right
# when a Traefik or nginx on the same host sends the traffic here. Set 0.0.0.0 to expose it on all interfaces.
# Empty means 127.0.0.1.
TOASCRIBE_HTTP_BIND=
# The address visitors use, with scheme and no trailing slash: https://example.com once an external Traefik
# or nginx with TLS sits in front. Empty means http://localhost:<TOASCRIBE_HTTP_PORT>.
PUBLIC_ORIGIN=
# The one proxy whose X-Forwarded-For/-Proto/-Host the stack believes: a single IP address, e.g. the fixed address you
# gave your proxy container on the edge network (10.231.97.250), or 10.231.97.1 for a proxy on this host with
# TOASCRIBE_HTTP_BIND=127.0.0.1 and rootful Docker. Not a range (/24, 10.0.0.0/8): that would trust every container
# and host process that can reach the port. Empty (the default) trusts nobody, which is safe: the proxy then ignores
# those headers from every client. The client address reaches the apps in X-Real-IP. README, «Behind a reverse proxy».
TOASCRIBE_TRUSTED_PROXY=
# Subnet of the "edge" network, where an external proxy in a container joins the stack (network name
# toascribe_edge). Fixed so that the address to trust is known: with the default 10.231.97.0/24 the host side of the
# published port is 10.231.97.1. Change it only if docker reports "Pool overlaps" for it. Empty means the default.
TOASCRIBE_EDGE_SUBNET=

# ── Images ───────────────────────────────────────────────
# Version of the toascribe images. With --build this only names the images you build.
TOASCRIBE_VERSION=0.3.0

# ── Logging ──────────────────────────────────────────────
# debug | info | warn | error (api, worker and the migrate step)
LOG_LEVEL=info

# ── Optional services ────────────────────────────────────
# Valkey (cache) is off by default and unused by the apps for now. Uncomment to start it.
# COMPOSE_PROFILES=valkey
#
# Mailpit catches all mail instead of sending it: for development and testing, never for a real site. Start it with
#   docker compose -f docker/compose.yaml --profile mailpit up -d      (or COMPOSE_PROFILES=mailpit)
# and set these in the E-mail section above:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_SECURE=none
#   MAIL_FROM_ADDRESS=toascribe@example.test
# The caught mails are at http://127.0.0.1:<TOASCRIBE_MAILPIT_PORT>. That is the one other published port, on this machine's
# loopback only, and the page has no login.
# Host port of the Mailpit page. Empty means 8025.
TOASCRIBE_MAILPIT_PORT=

# ── Set by compose.yaml, no need to change ───────────────
# NODE_ENV=production                    api, worker
# PORT=3001 / 3000                       api / site and admin listen ports (inside the containers)
# NUXT_API_URL_INTERNAL=http://api:3001  where the site and admin reach the api when rendering pages
# NUXT_PUBLIC_API_BASE=/api              where the browser reaches the api (same origin, through the proxy)
# WORKER_HEARTBEAT_FILE                  file the worker touches for its healthcheck
#
# The admin path /admin is fixed, not a setting: the admin app is built with it and the proxy's Caddyfile routes /admin and
# /setup there. Setting NUXT_APP_BASE_URL at run time would not move it unless the Caddyfile changed too.

# ── Development only (not read by compose) ───────────────
# Superuser URL of a throwaway PostgreSQL 18 for `pnpm test`. The tests create and drop their own databases and
# roles on it, so never point it at a server that holds data. Example (the container below is disposable):
#   docker run --rm -d --name toascribe-test-db -p 127.0.0.1:55432:5432 -e POSTGRES_PASSWORD=<password> postgres:18-alpine
#   TEST_DATABASE_URL=postgres://postgres:<password>@127.0.0.1:55432/postgres
# TEST_DATABASE_URL=
